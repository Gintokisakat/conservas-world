# Configuración de Conservas del Mundo
# Copiar a .env y ajustar valores

# Base de datos
CONSERVAS_DB=data/build.db

# JWT Secret (generar con: openssl rand -base64 48)
CONSERVAS_JWT_SECRET=

# URL del sitio (para SEO y sitemap)
CONSERVAS_SITE_URL=https://conservas-del-mundo.onrender.com

# CORS (separados por coma, o * para todos)
CONSERVAS_CORS_ORIGINS=*

# Entorno (production/development)
CONSERVAS_ENV=development

# Warmup de cachés al arrancar (1/0)
CONSERVAS_WARMUP=1

# Release de la BD para restaurar
CONSERVAS_DB_RELEASE=

# Fetch de FlavorDB (1/0)
CONSERVAS_FETCH_FLAVORDB=0
